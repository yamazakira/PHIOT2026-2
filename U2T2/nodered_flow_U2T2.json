    {
        "id": "painel",
        "type": "ui_template",
        "z": "flow_u2t2",
        "group": "g_alert",
        "name": "Painel de alertas",
        "order": 1,
        "width": 6,
        "height": 4,
        "format": "<style>\n  .al-row{display:flex;align-items:center;justify-content:space-between;padding:8px 4px;border-bottom:1px solid rgba(128,128,128,.25)}\n  .al-dot{height:18px;border-radius:50%;margin-right:10px;flex:none;background:#666}\n  .al-on .al-dot{animation:al-pisca .8s infinite alternate}\n  @keyframes al-pisca{from{opacity:1}to{opacity:.25}}\n</style>\n<div ng-repeat=\"it in itens\" class=\"al-row\" ng-class=\"{'al-on': estado[it.k]==1}\">\n  <div style=\"display:flex;align-items:center\">\n    <span class=\"al-dot\" ng-style=\"{'background': estado[it.k]==1 ? it.cor : '#666'}\"></span>{{it.nome}}\n  </div>\n  <b ng-style=\"{'color': estado[it.k]==1 ? it.cor : 'inherit'}\">{{estado[it.k]==1 ? 'ALERTA' : 'Normal'}}</b>\n</div>\n<script>\n(function(scope){\n  scope.itens = [\n    {k:'presenca',   nome:'Presença detectada',         cor:'#ffc107'},\n    {k:'temp_alta',  nome:'Temperatura alta (> 25 °C)',  cor:'#f44336'},\n    {k:'temp_baixa', nome:'Temperatura baixa (< 20 °C)', cor:'#2196f3'},\n    {k:'umidade',    nome:'Umidade alta (> 50 %)',       cor:'#4caf50'}\n  ];\n  scope.estado = {};\n  scope.$watch('msg', function(m){ if (m && m.payload) scope.estado = m.payload; });\n})(scope);\n</script>",
