    {
        "id": "f_temp",
        "type": "function",
        "z": "flow_u2t2",
        "name": "Alertas temperatura",
        "func": "// Lógica dos alertas de temperatura (fica no Node-RED, não no ESP32)\nconst BASE = \"/ESP32_U2T2_AKIRA\";\nconst t = Number(msg.payload);\nif (isNaN(t)) return null;\n\nconst alta  = t > 25 ? 1 : 0;   // acima de 25 °C\nconst baixa = t < 20 ? 1 : 0;   // abaixo de 20 °C\n\n// estado de todos os alertas (compartilhado com os outros nós)\nconst a = flow.get('alertas') || {presenca:0, temp_alta:0, temp_baixa:0, umidade:0};\nlet aviso = null;\nif (alta && !a.temp_alta)   aviso = { topic: \"Temperatura ALTA\",  payload: `Alerta: temperatura alta, ${t.toFixed(1)} graus` };\nif (baixa && !a.temp_baixa) aviso = { topic: \"Temperatura BAIXA\", payload: `Alerta: temperatura baixa, ${t.toFixed(1)} graus` };\na.temp_alta = alta; a.temp_baixa = baixa;\nflow.set('alertas', a);\n\nreturn [\n    { topic: \"Temperatura (°C)\", payload: t },                       // 1: gauge/gráfico\n    [ { topic: BASE + \"/LED/temp_alta\",  payload: String(alta)  },     // 2: LEDs no ESP32\n      { topic: BASE + \"/LED/temp_baixa\", payload: String(baixa) } ],\n    { payload: Object.assign({}, a) },                                // 3: painel de alertas\n    aviso                                                               // 4: notificação/voz (só quando o alarme dispara)\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 80,
        "wires": [
            [
                "g_temp",
                "chart"
            ],
            [
                "mq_out"
            ],
            [
                "painel"
            ],
            [
                "toast",
                "audio"
            ]
        ]
    },
    {
        "id": "f_umid",
        "type": "function",
        "z": "flow_u2t2",
        "name": "Alerta umidade",
        "func": "// Lógica do alerta de umidade\nconst BASE = \"/ESP32_U2T2_AKIRA\";\nconst h = Number(msg.payload);\nif (isNaN(h)) return null;\n\nconst alto = h > 50 ? 1 : 0;    // acima de 50 %\n\nconst a = flow.get('alertas') || {presenca:0, temp_alta:0, temp_baixa:0, umidade:0};\nlet aviso = null;\nif (alto && !a.umidade) aviso = { topic: \"Umidade ALTA\", payload: `Alerta: umidade alta, ${h.toFixed(0)} por cento` };\na.umidade = alto;\nflow.set('alertas', a);\n\nreturn [\n    { topic: \"Umidade (%)\", payload: h },\n    { topic: BASE + \"/LED/umidade\", payload: String(alto) },\n    { payload: Object.assign({}, a) },\n    aviso\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
        "wires": [
            [
                "g_umid",
                "chart"
            ],
            [
                "mq_out"
            ],
            [
                "painel"
            ],
            [
                "toast",
                "audio"
            ]
        ]
    },
    {
        "id": "f_pres",
        "type": "function",
        "z": "flow_u2t2",
        "name": "Alarme presença",
        "func": "// Lógica do alarme de presença\nconst BASE = \"/ESP32_U2T2_AKIRA\";\nconst p = String(msg.payload).trim() === \"1\" ? 1 : 0;\n\nconst a = flow.get('alertas') || {presenca:0, temp_alta:0, temp_baixa:0, umidade:0};\nlet aviso = null;\nif (p && !a.presenca) aviso = { topic: \"PRESENÇA detectada\", payload: \"Alerta: presença detectada\" };\na.presenca = p;\nflow.set('alertas', a);\n\nreturn [\n    { payload: p ? \"DETECTADA\" : \"Nenhuma\" },\n    { topic: BASE + \"/LED/presenca\", payload: String(p) },\n    { payload: Object.assign({}, a) },\n    aviso\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 320,
        "wires": [
            [
                "t_pres"
            ],
            [
                "mq_out"
            ],
            [
                "painel"
            ],
            [
                "toast",
                "audio"
            ]
        ]
    },
